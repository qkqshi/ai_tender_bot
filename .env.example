# Required: create a Telegram bot with @BotFather.
BOT_TOKEN=

# Optional: Telegram user ID for parser error notifications.
ADMIN_ID=

# Optional proxies. Format: http://user:password@host:port
TELEGRAM_PROXY_URL=
B2B_PROXY_URL=

# B2B-Center authentication. Never commit real values.
B2B_COOKIE=

# Optional captcha providers.
RUCAPTCHA_API_KEY=
ANTICAPTCHA_API_KEY=
